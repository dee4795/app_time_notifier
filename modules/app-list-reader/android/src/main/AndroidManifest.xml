<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets our app SEE apps that have a home screen icon (Android 11 and newer).
       This is NOT the restricted QUERY_ALL_PACKAGES permission.
       It lives inside the module, so it survives a clean prebuild. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
</manifest>